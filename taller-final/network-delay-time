
import heapq

class Solution:
    def networkDelayTime(self, times, n, k):

        # Crear el grafo
        graph = [[] for _ in range(n + 1)]

        for u, v, w in times:
            graph[u].append((v, w))

        # Inicializar distancias
        dist = [float('inf')] * (n + 1)
        dist[k] = 0

        # Heap: (distancia, nodo)
        heap = [(0, k)]

        while heap:
            current_dist, node = heapq.heappop(heap)

            # Ignorar distancias desactualizadas
            if current_dist > dist[node]:
                continue

            # Recorrer vecinos
            for neighbor, weight in graph[node]:

                new_dist = current_dist + weight

                if new_dist < dist[neighbor]:
                    dist[neighbor] = new_dist
                    heapq.heappush(
                        heap,
                        (new_dist, neighbor)
                    )

        # Verificar si todos recibieron la señal
        max_time = max(dist[1:])

        if max_time == float('inf'):
            return -1

        return max_time
