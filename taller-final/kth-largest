import heapq

class Solution:
    def findKthLargest(self, nums: list[int], k: int) -> int:

        # Crear un Min-Heap vacío
        heap = []

        # Recorrer todos los elementos del arreglo
        for num in nums:

            # Insertar el elemento en el Heap
            heapq.heappush(heap, num)

            # Mantener el Heap con máximo k elementos
            if len(heap) > k:
                heapq.heappop(heap)

        # La raíz contiene el k-ésimo mayor
        return heap[0]
